<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:icon="@mipmap/pitin_app_icon"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">
        <!-- No distractionOptimized declaration: this is a parked development app. -->
        <activity android:name=".ConnectedPresetsActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:theme="@style/PitIn.Car"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|fontScale|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="OPEN_PIT_IN" />
                <action android:name="PREPARE_QUIET_REST" />
                <action android:name="OPEN_CABIN_SETTINGS" />
                <action android:name="SET_CABIN" />
                <!-- The Gleo app on the Pleos Connect emulator sends "<package>.<function>" (seen 2026-11-13);
                     the public guide shows the bare function name. Both are declared. -->
                <action android:name="${applicationId}.PREPARE_QUIET_REST" />
                <action android:name="${applicationId}.OPEN_CABIN_SETTINGS" />
                <action android:name="${applicationId}.SET_CABIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
