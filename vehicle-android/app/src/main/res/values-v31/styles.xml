<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: no icon on the system starting window, only the dark ground; the app intro then starts with the words. -->
    <style name="PitIn.Car" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pitin_graphite_bg</item>
        <item name="android:statusBarColor">@color/pitin_graphite_bg</item>
        <item name="android:navigationBarColor">@color/pitin_graphite_bg</item>
        <item name="android:colorAccent">#FFF4EFE7</item>
        <item name="android:windowSplashScreenBackground">@color/pitin_graphite_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
